<Project Sdk="Microsoft.NET.Sdk;Cvr.Mod.Sdk">

  <PropertyGroup>
    <Version>1.3.8</Version>
    <_LimbGrabberCompatProject>$(MSBuildProjectDirectory)\LimbGrabberCompat\CVRLimbsGrabber.csproj</_LimbGrabberCompatProject>
    <_LimbGrabberCompatOutputDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\obj\LimbGrabberCompat\$(Configuration)\$(TargetFramework)\'))</_LimbGrabberCompatOutputDir>
    <_LimbGrabberCompatAssembly>$(_LimbGrabberCompatOutputDir)CVRLimbsGrabber.dll</_LimbGrabberCompatAssembly>
  </PropertyGroup>
  
  <ItemGroup>
    <Compile Remove="LimbGrabberUnity\**" />
    <EmbeddedResource Remove="LimbGrabberUnity\**" />
    <None Remove="LimbGrabberUnity\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="LimbGrabberCompat\**" />
    <EmbeddedResource Remove="LimbGrabberCompat\**" />
    <None Remove="LimbGrabberCompat\**" />
  </ItemGroup>

  <Target Name="BuildCompatAssembly" BeforeTargets="BeforeBuild" Condition=" '$(RECURSIVE_BUILD)' != 'true' ">
    <Message Text="Building Compatibility Assembly" Importance="high" />
    <Delete Files="$(_LimbGrabberCompatAssembly)" />
    <MSBuild Projects="$(_LimbGrabberCompatProject)"
             Targets="Build"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);Platform=$(Platform);RECURSIVE_BUILD=true;InstallOnBuild=false;CompatOutputPath=$(_LimbGrabberCompatOutputDir)" />

    <ItemGroup>
      <EmbeddedResource Remove="$(_LimbGrabberCompatAssembly)" />
      <EmbeddedResource Include="$(_LimbGrabberCompatAssembly)" Condition="Exists('$(_LimbGrabberCompatAssembly)')" />
    </ItemGroup>

    <Error Text="Expected compatibility assembly '$(_LimbGrabberCompatAssembly)' was not produced."
           Condition="!Exists('$(_LimbGrabberCompatAssembly)')" />
  </Target>

</Project>

